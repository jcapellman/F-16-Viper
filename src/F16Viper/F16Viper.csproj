<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>F16Viper</RootNamespace>
    <AssemblyName>F16Viper</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\F16Viper.Common.library\F16Viper.Common.library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(MonoGameInstallDirectory)\MonoGame\v3.0\Assemblies\WindowsDX\MonoGame.Framework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Import Project="..\F16Viper.library\F16Viper.library.projitems" Label="Shared" Condition="Exists('..\F16Viper.library\F16Viper.library.projitems')" />
</Project>
